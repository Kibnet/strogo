<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Strogo.Portable.V01">
      <HintPath>$(PortableAssemblyPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequirePortableAssembly" BeforeTargets="ResolveReferences">
    <Error Condition="'$(PortableAssemblyPath)' == ''" Text="PortableAssemblyPath is required." />
  </Target>
</Project>
